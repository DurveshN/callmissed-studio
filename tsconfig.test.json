{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    // Tests import renderer code, whose Konva typings need this off (see tsconfig.web.json).
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["tests/**/*", "src/**/*"]
}
